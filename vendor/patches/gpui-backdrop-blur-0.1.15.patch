+        self.next_frame.scene.insert_primitive(BackdropBlur {
+            order: 0,
+            bounds: self.snap_bounds(bounds),
+            content_mask: self.snapped_content_mask(),
+            corner_radii: corner_radii.scale(self.scale_factor()),
+            radius: self.snap_stroke(radius),
