+use std::ops::Range;
+
+use crate::{SharedString, TextRun, WhiteSpace};
+
+/// A replacement in byte coordinates; unchanged spans need no entries.
+#[derive(Debug, Clone)]
+pub(crate) struct TextEdit {
+    pub source: Range<usize>,
+    pub display: Range<usize>,
+}
+
+#[derive(Debug)]
+pub(crate) struct TextOffsetMap {
+    edits: Vec<TextEdit>,
+    source_len: usize,
+    display_len: usize,
+}
+
+impl TextOffsetMap {
+    pub(crate) fn to_display(&self, index: usize) -> usize {
+        let index = index.min(self.source_len);
+        let next = self.edits.partition_point(|edit| edit.source.end <= index);
+        if let Some(edit) = self.edits.get(next)
+            && index >= edit.source.start
+        {
+            return edit.display.start;
+        }
+        self.edits[..next]
+            .last()
+            .map_or(index, |edit| edit.display.end + index - edit.source.end)
+    }
+
+    pub(crate) fn to_source(&self, index: usize) -> usize {
+        let index = index.min(self.display_len);
+        let next = self.edits.partition_point(|edit| edit.display.end <= index);
+        if let Some(edit) = self.edits.get(next)
+            && index >= edit.display.start
+        {
+            return edit.source.start;
+        }
+        self.edits[..next]
+            .last()
+            .map_or(index, |edit| edit.source.end + index - edit.display.end)
+    }
+}
+
+fn is_collapsible_whitespace(c: char) -> bool {
+    matches!(c, ' ' | '\t' | '\n' | '\r' | '\u{0C}')
+}
+
+/// Normal/nowrap collapse ASCII whitespace; pre-wrap only normalizes segment breaks.
+pub(crate) fn normalize_whitespace(
+    text: &str,
+    runs: &[TextRun],
+    white_space: WhiteSpace,
+) -> Option<(SharedString, Vec<TextRun>, TextOffsetMap)> {
+    let preserve = white_space == WhiteSpace::PreWrap;
+    let needs_normalizing = if preserve {
+        text.contains(['\r', '\u{0C}'])
+    } else {
+        text.starts_with(' ')
+            || text.ends_with(' ')
+            || text.contains("  ")
+            || text.contains(['\t', '\n', '\r', '\u{0C}'])
+    };
+    if !needs_normalizing || runs.iter().map(|run| run.len).sum::<usize>() != text.len() {
+        return None;
+    }
+
+    let mut display = String::with_capacity(text.len());
+    let mut display_runs: Vec<TextRun> = Vec::with_capacity(runs.len());
+    let mut edits = Vec::new();
+    let mut run_index = 0;
+    let mut run_end = runs.first()?.len;
+    let mut previous_run = None;
+    let mut chars = text.char_indices().peekable();
+    while let Some((start, c)) = chars.next() {
+        while start >= run_end {
+            run_index += 1;
+            run_end += runs.get(run_index)?.len;
+        }
+        let mut end = start + c.len_utf8();
+        let replacement = if !preserve && is_collapsible_whitespace(c) {
+            while let Some(&(index, c)) = chars.peek() {
+                if !is_collapsible_whitespace(c) {
+                    break;
+                }
+                end = index + c.len_utf8();
+                chars.next();
+            }
+            if display.is_empty() || end == text.len() {
+                ""
+            } else {
+                " "
+            }
+        } else if preserve && matches!(c, '\r' | '\u{0C}') {
+            if c == '\r' && chars.peek().is_some_and(|(_, c)| *c == '\n') {
+                end += 1;
+                chars.next();
+            }
+            "\n"
+        } else {
+            &text[start..end]
+        };
+        let display_start = display.len();
+        display.push_str(replacement);
+        if replacement != &text[start..end] {
+            edits.push(TextEdit {
+                source: start..end,
+                display: display_start..display.len(),
+            });
+        }
+        if !replacement.is_empty() {
+            if previous_run == Some(run_index) {
+                display_runs.last_mut().unwrap().len += replacement.len();
+            } else {
+                let mut run = runs[run_index].clone();
+                run.len = replacement.len();
+                display_runs.push(run);
+                previous_run = Some(run_index);
+            }
+        }
+    }
+    let map = TextOffsetMap {
+        edits,
+        source_len: text.len(),
+        display_len: display.len(),
+    };
+    Some((display.into(), display_runs, map))
+}
+
+impl TextEdit {
+    /// Hidden source bytes have no painted position; the two edges remain addressable.
+    pub(crate) fn to_display(&self, index: usize) -> Option<usize> {
+        if index > self.source.start && index < self.source.end {
+            None
+        } else if index >= self.source.end {
+            Some(self.display.end + index - self.source.end)
+        } else {
+            Some(index)
+        }
+    }
+
+    pub(crate) fn to_source(&self, index: usize) -> usize {
+        if index >= self.display.end {
+            self.source.end + index - self.display.end
+        } else if index >= self.display.start {
+            self.source.start
+        } else {
+            index
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn dummy_runs(text: &str) -> Vec<TextRun> {
+        vec![TextRun {
+            len: text.len(),
+            ..Default::default()
+        }]
+    }
+
+    fn normalize(text: &str, mode: WhiteSpace) -> (SharedString, Vec<TextRun>, TextOffsetMap) {
+        normalize_whitespace(text, &dummy_runs(text), mode).unwrap()
+    }
+
+    #[test]
+    fn whitespace_modes_preserve_unicode_spaces_and_normalize_segment_breaks() {
+        for mode in [WhiteSpace::Normal, WhiteSpace::Nowrap] {
+            let (text, runs, _) = normalize(" \ta\r\n\u{0c} b \n", mode);
+            assert_eq!(text.as_ref(), "a b");
+            assert_eq!(runs.iter().map(|run| run.len).sum::<usize>(), text.len());
+            for text in ["", "a b", "稻　香", "a\u{a0}b", "a\u{b}b"] {
+                assert!(normalize_whitespace(text, &dummy_runs(text), mode).is_none());
+            }
+        }
+        let (text, _, _) = normalize(" a\r\nb\rc\u{0c}d\t ", WhiteSpace::PreWrap);
+        assert_eq!(text.as_ref(), " a\nb\nc\nd\t ");
+        assert!(
+            normalize_whitespace("a\n  b\t", &dummy_runs("a\n  b\t"), WhiteSpace::PreWrap)
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn whitespace_keeps_run_styles_across_collapsed_and_empty_runs() {
+        let text = " a bcd";
+        let mut runs = [2, 0, 1, 3].map(|len| TextRun {
+            len,
+            ..Default::default()
+        });
+        for (index, run) in runs.iter_mut().enumerate() {
+            run.font.family = format!("run-{index}").into();
+        }
+        let (text, result, _) = normalize_whitespace(text, &runs, WhiteSpace::Normal).unwrap();
+        assert_eq!(text.as_ref(), "a bcd");
+        assert_eq!(
+            result.iter().map(|run| run.len).collect::<Vec<_>>(),
+            [1, 1, 3]
+        );
+        assert_eq!(
+            result
+                .iter()
+                .map(|run| run.font.family.as_ref())
+                .collect::<Vec<_>>(),
+            ["run-0", "run-2", "run-3"]
+        );
+        let text = "a \t\nb";
+        let mut runs = dummy_runs(text);
+        runs[0].len = 2;
+        runs.push(TextRun {
+            len: 3,
+            ..Default::default()
+        });
+        let (_, result, _) = normalize_whitespace(text, &runs, WhiteSpace::Normal).unwrap();
+        assert_eq!(result.iter().map(|run| run.len).collect::<Vec<_>>(), [2, 1]);
+    }
+
+    #[test]
+    fn whitespace_offsets_cover_edges_multibyte_and_empty_output() {
+        for original in ["a  ", "  a", " \t\n", " 稻\r\n\t香  ", "a\r\nb"] {
+            for mode in [WhiteSpace::Normal, WhiteSpace::Nowrap, WhiteSpace::PreWrap] {
+                let Some((display, _, map)) =
+                    normalize_whitespace(original, &dummy_runs(original), mode)
+                else {
+                    continue;
+                };
+                let mut previous = 0;
+                for index in (0..=original.len()).filter(|index| original.is_char_boundary(*index))
+                {
+                    let offset = map.to_display(index);
+                    assert!(offset >= previous && display.is_char_boundary(offset));
+                    previous = offset;
+                }
+                previous = 0;
+                for index in (0..=display.len()).filter(|index| display.is_char_boundary(*index)) {
+                    let offset = map.to_source(index);
+                    assert!(offset >= previous && original.is_char_boundary(offset));
+                    assert_eq!(map.to_display(offset), index);
+                    previous = offset;
+                }
+                assert_eq!(map.to_display(usize::MAX), display.len());
+                assert_eq!(map.to_source(usize::MAX), original.len());
+            }
+        }
+        let (_, _, map) = normalize("a  ", WhiteSpace::Normal);
+        assert_eq!(map.to_display(3), 1);
+        assert_eq!(map.edits.len(), 1);
+    }
+
+    #[test]
+    fn truncation_offsets_compose_with_whitespace_in_original_coordinates() {
+        let original = "  ab  cdef  ";
+        let (_, _, map) = normalize(original, WhiteSpace::Normal);
+        // "ab cdef" -> end: "ab…", start: "…def", middle: "ab…ef".
+        for edit in [
+            TextEdit {
+                source: 2..7,
+                display: 2..5,
+            },
+            TextEdit {
+                source: 0..4,
+                display: 0..3,
+            },
+            TextEdit {
+                source: 2..5,
+                display: 2..5,
+            },
+            TextEdit {
+                source: 2..7,
+                display: 2..2,
+            },
+        ] {
+            let before = map.to_source(edit.source.start);
+            let after = map.to_source(edit.source.end);
+            let hidden = map.to_source(edit.source.start + 1);
+            assert_eq!(
+                edit.to_display(map.to_display(before)),
+                Some(edit.display.start)
+            );
+            assert_eq!(
+                edit.to_display(map.to_display(after)),
+                Some(edit.display.end)
+            );
+            assert_eq!(edit.to_display(map.to_display(hidden)), None);
+            assert_eq!(map.to_source(edit.to_source(edit.display.end)), after);
+            if !edit.display.is_empty() {
+                assert_eq!(map.to_source(edit.to_source(edit.display.start)), before);
+            }
+        }
+    }
