+struct BackdropBlurVertexOutput {
+  float4 position [[position]];
+  float4 clip_distance;
+  uint blur_id [[flat]];
+};
+
+vertex BackdropBlurVertexOutput backdrop_blur_vertex(
+    uint vertex_id [[vertex_id]], uint blur_id [[instance_id]],
+    constant float2 *unit_vertices [[buffer(BackdropBlurInputIndex_Vertices)]],
+    constant BackdropBlur *blurs [[buffer(BackdropBlurInputIndex_Blurs)]],
+    constant Size_DevicePixels *viewport_size [[buffer(BackdropBlurInputIndex_ViewportSize)]]) {
+  float2 unit = unit_vertices[vertex_id];
+  BackdropBlur blur = blurs[blur_id];
+  float4 clip = distance_from_clip_rect(unit, blur.bounds, blur.content_mask.bounds);
+  return {to_device_position(unit, blur.bounds, viewport_size), clip, blur_id};
+}
+
+fragment float4 backdrop_blur_fragment(
+    BackdropBlurVertexOutput input [[stage_in]],
+    constant BackdropBlur *blurs [[buffer(BackdropBlurInputIndex_Blurs)]],
+    texture2d<float> source [[texture(0)]]) {
+  if (any(input.clip_distance < float4(0.0))) return float4(0.0);
+  BackdropBlur blur = blurs[input.blur_id];
+  float distance = quad_sdf(input.position.xy, blur.bounds, blur.corner_radii);
+  if (distance > 0.5) return float4(0.0);
+  // Trilinear sampling is required for the explicit `level()` below to work:
+  // with mip_filter::none the sampler stays "not mipmapped" and every tap reads
+  // level 0, which is what aliases the backdrop into a visible grid.
+  constexpr sampler linear_sampler(mag_filter::linear, min_filter::linear, mip_filter::linear);
+  float2 texel = 1.0 / float2(source.get_width(), source.get_height());
+  float2 uv = input.position.xy * texel;
+  float radius = max(blur.radius, 0.5);
+  // The 17x17 taps sit on a lattice whose spacing grows with the radius. A tap
+  // reaches only one texel at level 0, so once the spacing passes a texel the
+  // lattice starts aliasing the backdrop into a grid. Read the mip level whose
+  // texels are as wide as the spacing instead, so a tap averages a whole cell.
+  float spacing = max(radius * 0.25, 1.0);
+  float lod = clamp(log2(spacing), 0.0, float(source.get_num_mip_levels() - 1));
+  float4 color = float4(0.0);
+  float weight_sum = 0.0;
+  for (int y = -8; y <= 8; ++y) {
+    for (int x = -8; x <= 8; ++x) {
+      float weight = exp(-float(x * x + y * y) / 32.0);
+      color += source.sample(linear_sampler, uv + float2(x, y) * texel * spacing, level(lod)) * weight;
+      weight_sum += weight;
+    }
+  }
+  color /= weight_sum;
+  color *= saturate(0.5 - distance);
   return color;
 }
 
