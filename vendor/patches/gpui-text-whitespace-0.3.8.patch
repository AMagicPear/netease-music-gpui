+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn dummy_runs(text: &str) -> Vec<TextRun> {
+        vec![TextRun {
+            len: text.len(),
+            ..Default::default()
+        }]
+    }
+
+    fn normalize(text: &str, mode: WhiteSpace) -> (SharedString, Vec<TextRun>, TextOffsetMap) {
+        normalize_whitespace(text, &dummy_runs(text), mode).unwrap()
+    }
+
+    #[test]
+    fn whitespace_modes_preserve_unicode_spaces_and_normalize_segment_breaks() {
+        for mode in [WhiteSpace::Normal, WhiteSpace::Nowrap] {
+            let (text, runs, _) = normalize(" \ta\r\n\u{0c} b \n", mode);
+            assert_eq!(text.as_ref(), "a b");
+            assert_eq!(runs.iter().map(|run| run.len).sum::<usize>(), text.len());
+            for text in ["", "a b", "稻　香", "a\u{a0}b", "a\u{b}b"] {
+                assert!(normalize_whitespace(text, &dummy_runs(text), mode).is_none());
+            }
+        }
+        let (text, _, _) = normalize(" a\r\nb\rc\u{0c}d\t ", WhiteSpace::PreWrap);
+        assert_eq!(text.as_ref(), " a\nb\nc\nd\t ");
+        assert!(
+            normalize_whitespace("a\n  b\t", &dummy_runs("a\n  b\t"), WhiteSpace::PreWrap)
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn whitespace_keeps_run_styles_across_collapsed_and_empty_runs() {
+        let text = " a bcd";
+        let mut runs = [2, 0, 1, 3].map(|len| TextRun {
+            len,
+            ..Default::default()
+        });
+        for (index, run) in runs.iter_mut().enumerate() {
+            run.font.family = format!("run-{index}").into();
+        }
+        let (text, result, _) = normalize_whitespace(text, &runs, WhiteSpace::Normal).unwrap();
+        assert_eq!(text.as_ref(), "a bcd");
+        assert_eq!(
+            result.iter().map(|run| run.len).collect::<Vec<_>>(),
+            [1, 1, 3]
+        );
+        assert_eq!(
+            result
+                .iter()
+                .map(|run| run.font.family.as_ref())
+                .collect::<Vec<_>>(),
+            ["run-0", "run-2", "run-3"]
+        );
+        let text = "a \t\nb";
+        let mut runs = dummy_runs(text);
+        runs[0].len = 2;
+        runs.push(TextRun {
+            len: 3,
+            ..Default::default()
+        });
+        let (_, result, _) = normalize_whitespace(text, &runs, WhiteSpace::Normal).unwrap();
+        assert_eq!(result.iter().map(|run| run.len).collect::<Vec<_>>(), [2, 1]);
+    }
+
+    #[test]
+    fn whitespace_offsets_cover_edges_multibyte_and_empty_output() {
+        for original in ["a  ", "  a", " \t\n", " 稻\r\n\t香  ", "a\r\nb"] {
+            for mode in [WhiteSpace::Normal, WhiteSpace::Nowrap, WhiteSpace::PreWrap] {
+                let Some((display, _, map)) =
+                    normalize_whitespace(original, &dummy_runs(original), mode)
+                else {
+                    continue;
+                };
+                let mut previous = 0;
+                for index in (0..=original.len()).filter(|index| original.is_char_boundary(*index))
+                {
+                    let offset = map.to_display(index);
+                    assert!(offset >= previous && display.is_char_boundary(offset));
+                    previous = offset;
+                }
+                previous = 0;
+                for index in (0..=display.len()).filter(|index| display.is_char_boundary(*index)) {
+                    let offset = map.to_source(index);
+                    assert!(offset >= previous && original.is_char_boundary(offset));
+                    assert_eq!(map.to_display(offset), index);
+                    previous = offset;
+                }
+                assert_eq!(map.to_display(usize::MAX), display.len());
+                assert_eq!(map.to_source(usize::MAX), original.len());
+            }
+        }
+        let (_, _, map) = normalize("a  ", WhiteSpace::Normal);
+        assert_eq!(map.to_display(3), 1);
+        assert_eq!(map.edits.len(), 1);
+    }
+
+    #[test]
+    fn truncation_offsets_compose_with_whitespace_in_original_coordinates() {
+        let original = "  ab  cdef  ";
+        let (_, _, map) = normalize(original, WhiteSpace::Normal);
+        // "ab cdef" -> end: "ab…", start: "…def", middle: "ab…ef".
+        for edit in [
+            TextEdit {
+                source: 2..7,
+                display: 2..5,
+            },
+            TextEdit {
+                source: 0..4,
+                display: 0..3,
+            },
+            TextEdit {
+                source: 2..5,
+                display: 2..5,
+            },
+            TextEdit {
+                source: 2..7,
+                display: 2..2,
+            },
+        ] {
+            let before = map.to_source(edit.source.start);
+            let after = map.to_source(edit.source.end);
+            let hidden = map.to_source(edit.source.start + 1);
+            assert_eq!(
+                edit.to_display(map.to_display(before)),
+                Some(edit.display.start)
+            );
+            assert_eq!(
+                edit.to_display(map.to_display(after)),
+                Some(edit.display.end)
+            );
+            assert_eq!(edit.to_display(map.to_display(hidden)), None);
+            assert_eq!(map.to_source(edit.to_source(edit.display.end)), after);
+            if !edit.display.is_empty() {
+                assert_eq!(map.to_source(edit.to_source(edit.display.start)), before);
+            }
+        }
+    }
