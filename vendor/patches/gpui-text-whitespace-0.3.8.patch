+use std::ops::Range;
+
+use crate::{SharedString, TextRun, WhiteSpace};
+
+/// A replacement in byte coordinates; unchanged spans need no entries.
+#[derive(Debug, Clone)]
+pub(crate) struct TextEdit {
+    pub source: Range<usize>,
+    pub display: Range<usize>,
+}
+
+#[derive(Debug)]
+pub(crate) struct TextOffsetMap {
+    edits: Vec<TextEdit>,
+    source_len: usize,
+    display_len: usize,
+}
+
+impl TextOffsetMap {
+    pub(crate) fn to_display(&self, index: usize) -> usize {
+        let index = index.min(self.source_len);
+        let next = self.edits.partition_point(|edit| edit.source.end <= index);
+        if let Some(edit) = self.edits.get(next)
+            && index >= edit.source.start
+        {
+            return edit.display.start;
+        }
+        self.edits[..next]
+            .last()
+            .map_or(index, |edit| edit.display.end + index - edit.source.end)
+    }
+
+    pub(crate) fn to_source(&self, index: usize) -> usize {
+        let index = index.min(self.display_len);
+        let next = self.edits.partition_point(|edit| edit.display.end <= index);
+        if let Some(edit) = self.edits.get(next)
+            && index >= edit.display.start
+        {
+            return edit.source.start;
+        }
+        self.edits[..next]
+            .last()
+            .map_or(index, |edit| edit.source.end + index - edit.display.end)
+    }
+}
+
+fn is_collapsible_whitespace(c: char) -> bool {
+    matches!(c, ' ' | '\t' | '\n' | '\r' | '\u{0C}')
+}
+
+/// Normal/nowrap collapse ASCII whitespace; pre-wrap only normalizes segment breaks.
+pub(crate) fn normalize_whitespace(
+    text: &str,
+    runs: &[TextRun],
+    white_space: WhiteSpace,
+) -> Option<(SharedString, Vec<TextRun>, TextOffsetMap)> {
+    let preserve = white_space == WhiteSpace::PreWrap;
+    let needs_normalizing = if preserve {
+        text.contains(['\r', '\u{0C}'])
+    } else {
+        text.starts_with(' ')
+            || text.ends_with(' ')
+            || text.contains("  ")
+            || text.contains(['\t', '\n', '\r', '\u{0C}'])
+    };
+    if !needs_normalizing || runs.iter().map(|run| run.len).sum::<usize>() != text.len() {
+        return None;
+    }
+
+    let mut display = String::with_capacity(text.len());
+    let mut display_runs: Vec<TextRun> = Vec::with_capacity(runs.len());
+    let mut edits = Vec::new();
+    let mut run_index = 0;
+    let mut run_end = runs.first()?.len;
+    let mut previous_run = None;
+    let mut chars = text.char_indices().peekable();
+    while let Some((start, c)) = chars.next() {
+        while start >= run_end {
+            run_index += 1;
+            run_end += runs.get(run_index)?.len;
+        }
+        let mut end = start + c.len_utf8();
+        let replacement = if !preserve && is_collapsible_whitespace(c) {
+            while let Some(&(index, c)) = chars.peek() {
+                if !is_collapsible_whitespace(c) {
+                    break;
+                }
+                end = index + c.len_utf8();
+                chars.next();
+            }
+            if display.is_empty() || end == text.len() {
+                ""
+            } else {
+                " "
+            }
+        } else if preserve && matches!(c, '\r' | '\u{0C}') {
+            if c == '\r' && chars.peek().is_some_and(|(_, c)| *c == '\n') {
+                end += 1;
+                chars.next();
+            }
+            "\n"
+        } else {
+            &text[start..end]
+        };
+        let display_start = display.len();
+        display.push_str(replacement);
+        if replacement != &text[start..end] {
+            edits.push(TextEdit {
+                source: start..end,
+                display: display_start..display.len(),
+            });
+        }
+        if !replacement.is_empty() {
+            if previous_run == Some(run_index) {
+                display_runs.last_mut().unwrap().len += replacement.len();
+            } else {
+                let mut run = runs[run_index].clone();
+                run.len = replacement.len();
+                display_runs.push(run);
+                previous_run = Some(run_index);
+            }
+        }
+    }
+    let map = TextOffsetMap {
+        edits,
+        source_len: text.len(),
+        display_len: display.len(),
+    };
+    Some((display.into(), display_runs, map))
+}
+
+impl TextEdit {
+    /// Hidden source bytes have no painted position; the two edges remain addressable.
+    pub(crate) fn to_display(&self, index: usize) -> Option<usize> {
+        if index > self.source.start && index < self.source.end {
+            None
+        } else if index >= self.source.end {
+            Some(self.display.end + index - self.source.end)
+        } else {
+            Some(index)
+        }
+    }
+
+    pub(crate) fn to_source(&self, index: usize) -> usize {
+        if index >= self.display.end {
+            self.source.end + index - self.display.end
+        } else if index >= self.display.start {
+            self.source.start
+        } else {
+            index
+        }
+    }
+}
